#!/usr/bin/env bash
# Fake docker. Logs each call.
#
# `buildx bake --print` prints $FAKE_STATE/bake-print. Any other bake prints $FAKE_STATE/bake-log to
# stderr, as a build's progress goes, and exits with $FAKE_STATE/bake-status (default 0).
set -euo pipefail
echo "docker $*" >>"$FAKE_STATE/calls"
case "${1:-}" in
  version)
    # version --format '{{.Server.Os}}/{{.Server.Arch}}': the runner's platform.
    cat "$FAKE_STATE/platform" 2>/dev/null || echo linux/amd64
    exit 0
    ;;
  image)
    # image inspect --format <template> <ref>. The platform template prints
    # $FAKE_STATE/image-platform, else the runner's. The health check template prints
    # $FAKE_STATE/healthcheck, or nothing when the image declares none. The layers template prints
    # $FAKE_STATE/loaded-layers.
    case "$*" in
      *'{{.Os}}/{{.Architecture}}'*) cat "$FAKE_STATE/image-platform" 2>/dev/null || cat "$FAKE_STATE/platform" 2>/dev/null || echo linux/amd64 ;;
      *Healthcheck*) cat "$FAKE_STATE/healthcheck" 2>/dev/null || true ;;
      *RootFS.Layers*) cat "$FAKE_STATE/loaded-layers" ;;
    esac
    exit 0
    ;;
  compose)
    # Logs the image compose was given; `up` exits with $FAKE_STATE/compose-status.
    echo "compose-env image=[${IMAGE_REF:-}]" >>"$FAKE_STATE/calls"
    case " $* " in
      *" up "*) exit "$(cat "$FAKE_STATE/compose-status" 2>/dev/null || echo 0)" ;;
      *" logs "*) echo "candidate-1  | the service's last words" ;;
    esac
    exit 0
    ;;
esac
if [ "${1:-} ${2:-}" != "buildx bake" ]; then
  echo "fake docker does not handle: $*" >&2
  exit 2
fi
case " $* " in
  *" --print "*) cat "$FAKE_STATE/bake-print" ;;
  *)
    cat "$FAKE_STATE/bake-log" >&2 2>/dev/null || true
    exit "$(cat "$FAKE_STATE/bake-status" 2>/dev/null || echo 0)"
    ;;
esac
